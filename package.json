{
  "name": "market-forecast-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "data:download": "tsx scripts/download-history.mjs",
    "demo:generate": "tsx scripts/make-demo.mjs",
    "data:validate": "tsx scripts/validate-data.mjs",
    "test": "vitest run tests/data.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "fancy-canvas": "2.1.0",
    "lightweight-charts": "5.2.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.15",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
